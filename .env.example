# AgentFlight Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# OpenAny Provider (Official Integration)
# Register at https://openany.si and generate an API key from the dashboard or CLI.
OPENANY_API_KEY=your_openany_api_key_here
OPENANY_BASE_URL=https://api.openany.si/v1
OPENANY_MCP_URL=https://mcp.openany.si/mcp
OPENANY_DEFAULT_MODEL=MiniMax-M2.5
OPENANY_MAX_BUDGET_USD=0.50
OPENANY_PARTNER_ID=agentflight

# AgentFlight Server Settings
AGENTFLIGHT_HOST=0.0.0.0
AGENTFLIGHT_PORT=8000
