{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "maintainers": [
    "codesphere-u"
  ],
  "name": "agentflight",
  "description": "AI agent black-box flight recorder, deterministic trajectory replay, loop circuit breaker, and MCP tool-smell linter.",
  "type": "mcp_server",
  "status": "production",
  "url": "https://agentflight-tau.vercel.app/mcp",
  "endpoints": {
    "streamable_http": "https://agentflight-tau.vercel.app/mcp",
    "sse": "https://agentflight-tau.vercel.app/sse",
    "health": "https://agentflight-tau.vercel.app/health"
  },
  "transport": [
    "streamable-http",
    "sse",
    "stdio"
  ],
  "keywords": [
    "mcp",
    "ai-agents",
    "flight-recorder",
    "circuit-breaker",
    "trajectory-replay",
    "tool-smell-linter"
  ],
  "capabilities": [
    "tools",
    "resources",
    "prompts"
  ]
}
